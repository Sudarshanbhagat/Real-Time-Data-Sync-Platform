# Copy to .env and adjust:  cp .env.example .env

# --- Application ---
APP_NAME="Real-Time Data Sync Platform"
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# --- PostgreSQL (used by docker-compose AND the app) ---
POSTGRES_USER=sync_user
POSTGRES_PASSWORD=sync_password
POSTGRES_DB=sync_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sync_user:sync_password@localhost:5432/sync_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Kafka ---
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SYNC_EVENTS_TOPIC=sync_events
KAFKA_CONSUMER_GROUP=sync_group
KAFKA_PUBLISH_TIMEOUT_MS=5000
# Run the background Kafka -> DB processor inside the API process
RUN_SYNC_PROCESSOR=true
# Entities processed in parallel per batch (keep below DB_POOL_SIZE)
SYNC_PROCESSOR_CONCURRENCY=10

# Managed Kafka (cloud). Local docker-compose needs none of these.
# KAFKA_SECURITY_PROTOCOL=SSL            # PLAINTEXT | SSL | SASL_SSL | SASL_PLAINTEXT
# KAFKA_SSL_CAFILE=./ca.pem              # or KAFKA_SSL_CA_PEM=<contents> in containers
# KAFKA_SSL_CERTFILE=./service.cert
# KAFKA_SSL_KEYFILE=./service.key
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# --- Observability ---
TRACING_ENABLED=false
OTEL_SERVICE_NAME=sync-platform
OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
GRAFANA_ADMIN_PASSWORD=admin
ZOOKEEPER_PORT=2181
KAFKA_UI_PORT=8080

# --- Redis (later phases) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

          "expr": "histogram_quantile(0.99, sum by (le) (rate(sync_processing_latency_seconds_bucket{outcome=~\"synced|failed\"}[1m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",

            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sync_processing_latency_seconds_bucket{outcome=~\"synced|failed\"}[1m])))",
          "legendFormat": "p95",
